{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run optimiser tests",
      "type": "shell",
      "command": "${config:python.defaultInterpreterPath}",
      "args": ["-m", "unittest", "discover", "-s", "tests", "-v"],
      "options": { "env": { "PYTHONPATH": "${workspaceFolder}/src" } },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Run local dashboard",
      "type": "shell",
      "command": "${config:python.defaultInterpreterPath}",
      "args": ["dashboard/app.py"],
      "options": { "env": { "PYTHONPATH": "${workspaceFolder}/src" } },
      "problemMatcher": []
    }
  ]
}
